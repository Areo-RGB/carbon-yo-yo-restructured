{
  "name": "yoyo-fitness-tracker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "svelte-check --tsconfig ./tsconfig.app.json && eslint .",
    "autofix": "node scripts/autofixer.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "android:sync": "node scripts/sync-android-assets.mjs",
    "android:build": "npm run build && npm run android:sync"
  },
  "dependencies": {
    "carbon-components-svelte": "^0.111.1",
    "carbon-icons-svelte": "^13.15.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22",
    "carbon-preprocess-svelte": "^0.11.43",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.1.4"
  }
}
